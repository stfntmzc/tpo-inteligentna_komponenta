# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test/cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build/package files
build/
dist/
*.egg-info/

# Local storage/uploads
storage/
uploads/
images/
test_images/

# AI/model cache files
.cache/
models_cache/
*.pt
*.pth
*.onnx
*.safetensors

# Uvicorn/FastAPI reload/debug
*.pid

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Ignoriraj vse mape znotraj test/datasets
test/datasets/*
!test/datasets/example_appropriate/
!test/datasets/example_appropriate/images
!test/datasets/example_appropriate/expected.txt
!test/datasets/example_inappropriate/
!test/datasets/example_inappropriate/images
!test/datasets/example_inappropriate/expected.txt

# Testne konfiguracije - ignoriraj vse eksperimente
test/configs/*

# Pusti samo example_config
!test/configs/example_config/
!test/configs/example_config/labels.txt
!test/configs/example_config/risk_labels.txt
!test/configs/example_config/threshold.txt